{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Videola",
  "version": "0.9.2",
  "identifier": "org.gilde.videola",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter videola-web build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter videola-web dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Videola",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Videola",
        "url": "splash.html",
        "width": 420,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "gilde.org",
    "homepage": "https://www.gilde.org",
    "copyright": "© 2026 Florian Gilde",
    "shortDescription": "Video editor",
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../../../LICENSE"
  }
}
