{
  "name": "videola-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "videola-mcp": "./dist/mcp.mjs",
    "videola-serve": "./dist/serve.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "node bundle/run.mjs",
    "build": "pnpm build:renderer && esbuild src/bin/serve.ts src/bin/mcp.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs",
    "build:renderer": "esbuild renderer/entry.ts --bundle --format=esm --target=es2022 --outfile=renderer/bundle.js",
    "serve": "node dist/serve.mjs",
    "mcp": "node dist/mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@videola/core": "workspace:*",
    "@videola/engine": "workspace:*",
    "@videola/media": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
